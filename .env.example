# The review layer (src/review) keeps notes in one of two places, chosen when the site is built:
#   - both Supabase values set  -> notes are shared live through Supabase ("Live" in the review bar);
#   - either one empty          -> notes stay in this browser only ("On this device").
# Create the table first with supabase/review.sql. Copy this file to .env.local and fill it in.

# Project Settings -> API -> Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_REVIEW_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public. It is meant to be public;
# the row level security policies in supabase/review.sql decide what it may do.
VITE_REVIEW_SUPABASE_ANON_KEY=

# Which review the notes belong to. The SQL policies allow "truemark"; change both together.
VITE_REVIEW_PROJECT=truemark
