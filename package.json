{
  "name": "truemark-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:live": "node scripts/build-site.mjs live",
    "build:launch": "node scripts/build-site.mjs launch",
    "test": "node scripts/verify-release.mjs --tests-only",
    "verify:release": "node scripts/verify-release.mjs",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "preview:messages": "tsx scripts/preview-messages.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --host 127.0.0.1 --base /TrueMark/",
    "dev:studio": "vite --config design-lab/universe/vite.config.mjs --open /design-lab/universe/index.html",
    "build:studio": "node design-lab/universe/package.mjs",
    "preview:studio": "node design-lab/universe/serve.mjs",
    "test:studio": "node --test design-lab/universe/*.test.mjs",
    "dev:platform": "node --import tsx scripts/local-platform.mjs dev",
    "platform:setup": "node --import tsx scripts/local-platform.mjs setup",
    "platform:stop": "node --import tsx scripts/local-platform.mjs stop",
    "platform:flush": "node --import tsx scripts/local-platform.mjs flush",
    "platform:verify": "node --import tsx scripts/local-verify.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:check": "node scripts/backup-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "postgres": "3.4.9",
    "supabase": "2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
